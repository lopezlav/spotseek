# The Homebrew cask for Spotseek. The release workflow fills in the version and checksums
# (scripts/render-cask.py) and pushes it to github.com/lopezlav/homebrew-tap:
#   brew install lopezlav/tap/spotseek
cask "spotseek" do
  arch arm: "arm64", intel: "x64"

  version "@VERSION@"
  sha256 arm:   "@SHA_ARM64@",
         intel: "@SHA_X64@"

  url "https://github.com/lopezlav/spotseek/releases/download/v#{version}/Spotseek-macOS-#{arch}.zip"
  name "Spotseek"
  desc "Downloads Spotify playlists as mp3 files from Soulseek and YouTube Music"
  homepage "https://github.com/lopezlav/spotseek"

  livecheck do
    url :url
    strategy :github_latest
  end

  # The app updates itself (the banner on its paste screen).
  auto_updates true
  depends_on macos: :monterey

  app "Spotseek.app"

  # The app is not signed by an Apple developer account: without this, macOS blocks it.
  postflight_steps do
    run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "{{appdir}}/Spotseek.app"], must_succeed: false
  end

  zap trash: "~/Library/Application Support/Spotseek"
end
